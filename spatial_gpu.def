Bootstrap: docker
From: jupyter/datascience-notebook:latest

%files
    envs/requirements-spatial-gpu.txt /app/requirements-spatial-gpu.txt
    envs/requirements-dev.txt /app/requirements-dev.txt
    envs/spatial_gpu.yaml /app/spatial_gpu.yaml
    tests /tests

%environment
    export PIXI_HOME="/opt/pixi"
    export XDG_CACHE_HOME="/tmp"
    export NUMBA_CACHE_DIR="/tmp/numba"
    export MPLCONFIGDIR="/tmp/matplotlib"

%apprun jupyterlab
    exec jupyter lab --no-browser "${@}"

%appinstall codeserver
    curl -fsSL https://code-server.dev/install.sh | sh

%apprun codeserver
    exec code-server "${@}"

%post
    export DEBIAN_FRONTEND="noninteractive"
    export PIXI_HOME="/opt/pixi"
    export PIXI_CACHE_DIR="/var/cache/pixi"
    export PATH="${PIXI_HOME}/bin:${PATH}"

    apt-get update
    apt-get install -y --no-install-recommends \
        bash-completion \
        bat \
        bison \
        build-essential \
        bzip2 \
        ca-certificates \
        cmake \
        curl \
        default-jdk \
        flex \
        fzf \
        g++ \
        gcc \
        git \
        graphviz \
        libgraphviz-dev \
        libtool \
        miller \
        shellcheck \
        tree \
        wget

    mkdir -p \
        /opt/pixi \
        /opt/spatial \
        /var/cache/pixi

    curl -fsSL https://pixi.sh/install.sh | PIXI_HOME="${PIXI_HOME}" bash
    pixi --version

    head -n -5 /app/spatial_gpu.yaml > /app/spatial_gpu_pixi.yaml
    pixi init /opt/spatial --import /app/spatial_gpu_pixi.yaml

    pixi import \
        --manifest-path /opt/spatial/pixi.toml \
        --format pypi-txt \
        --feature default \
        --environment default \
        /app/requirements-spatial-gpu.txt

    pixi import \
        --manifest-path /opt/spatial/pixi.toml \
        --format pypi-txt \
        --feature default \
        --environment default \
        /app/requirements-dev.txt

    pixi install --manifest-path /opt/spatial/pixi.toml

    pixi shell-hook \
        --manifest-path /opt/spatial/pixi.toml \
        --shell bash \
        --as-is \
        --no-completions \
        --change-ps1 false \
        > /opt/spatial/activate.sh

    chmod 0444 /opt/spatial/activate.sh
    cat /opt/spatial/activate.sh >> "${APPTAINER_ENVIRONMENT}"
    . /opt/spatial/activate.sh

    python --version
    jupyter lab --version
    jupyter kernelspec list

    apt-get clean
    rm -rf \
        /var/cache/pixi \
        /var/lib/apt/lists/* \
        /root/.cache

%runscript
    exec /usr/bin/bash "$@"

%test
    export NUMBA_DISABLE_CACHE=1
    export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1

    TOOLS="shellcheck git wget curl"
    for cmd in $TOOLS; do
        if command -v "$cmd" >/dev/null 2>&1; then
            echo "Command '${cmd}' is found."
        else
            echo "Command '${cmd}' is missing." >&2
            exit 1
        fi
    done

    if nvidia-smi >/dev/null 2>&1; then
        echo "nvidia-smi is detected:\n\t$(nvidia-smi --query-gpu=name,driver_version --format=csv,noheader)"
    else
        echo "nvidia-smi is not visible. Tests using GPU acceleration will be omitted."
        export RAPIDS_NO_INITIALIZE=1
        export CUDF_NO_INITIALIZE=1
    fi

    . /opt/spatial/activate.sh
    python -m pytest -p no:cacheprovider /tests

%labels
    Version {{ build_date }}
